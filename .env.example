# Local development environment variables.
#
# Copy this file to `.env` (repo root) and fill in real values to run the
# API server locally on Windows/macOS/Linux with `pnpm run dev`.
#
# On Replit, none of this is needed — these values are already provided via
# Replit Secrets/environment, which always take priority over `.env` (dotenv
# never overwrites a variable that's already set in the environment).
#
# On a VPS, set these as real environment variables (systemd EnvironmentFile,
# Docker --env-file, or export in your shell) rather than relying on .env.

# ── Database ────────────────────────────────────────────────────────────────

# Postgres connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/fnashha

# Enable SSL for the PostgreSQL connection (required for managed providers like
# DigitalOcean Managed PostgreSQL, AWS RDS, Supabase, etc.)
# Set to "true" if your DATABASE_URL does not already contain ?sslmode=require.
DB_SSL=false

# Set to "true" to also verify the server's SSL certificate against trusted CAs.
# Leave "false" (default) when using self-signed certs (common on managed hosts).
DB_SSL_REJECT_UNAUTHORIZED=false

# ── Auth / JWT ───────────────────────────────────────────────────────────────

# Auth/session signing secret (required — any long random string)
SESSION_SECRET=

# Optional: separate signing secret for refresh tokens.
# When not set, a deterministic secret is derived from SESSION_SECRET.
# JWT_REFRESH_SECRET=

# Optional: access token expiry (default: 15m)
# ACCESS_TOKEN_EXPIRES_IN=15m

# Optional: refresh token expiry (default: 30d)
# REFRESH_TOKEN_EXPIRES_IN=30d

# ── Founder account ──────────────────────────────────────────────────────────

# Mobile number used to bootstrap the initial Founder (super-admin) account.
# Must be set before first startup on a fresh database.
FOUNDER_PHONE=

# Password used to bootstrap the initial Founder account (required)
FOUNDER_PASSWORD=

# ── HTTP server ───────────────────────────────────────────────────────────────

# API server HTTP port (required — the server exits immediately if unset)
PORT=8080

# ── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins.
# Leave empty (or unset) to allow all origins — safe with Bearer-token auth.
# Example for production: CORS_ORIGIN=https://fnashha.com,https://www.fnashha.com
CORS_ORIGIN=

# ── Public URLs ───────────────────────────────────────────────────────────────

# Public base URL of the app, no trailing slash — used to build referral
# links ({PUBLIC_APP_URL}/r/{CODE}) and other public-facing URLs.
PUBLIC_APP_URL=http://localhost:3000

# ── File uploads ─────────────────────────────────────────────────────────────

# Absolute or relative path where user-uploaded files are stored on disk.
# Relative paths are resolved from the api-server working directory.
# On VPS, set an absolute path outside the repo (e.g. /var/fnashha/uploads)
# so uploads survive re-deployments and are easy to back up separately.
UPLOADS_DIR=/var/fnashha/uploads

# ── Backups ───────────────────────────────────────────────────────────────────

# Directory where database backup ZIP files are written.
# On VPS, use an absolute path outside the repo for the same reason as above.
BACKUPS_DIR=/var/fnashha/backups

# ── Logging ──────────────────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info

# ── Rate limiting ────────────────────────────────────────────────────────────

# These have sane production defaults — only override if you need to tune them.
# AUTH_LOGIN_RATE_LIMIT_MAX=5
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# AUTH_REGISTER_RATE_LIMIT_MAX=5
# AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# AUTH_REFRESH_RATE_LIMIT_MAX=30
# AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000

# ── CMS media uploads (Cloudinary) ──────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Push notifications (Firebase) ────────────────────────────────────────────

# Raw JSON of the Firebase service account (or base64-encoded JSON).
# Download from Firebase Console → Project Settings → Service Accounts.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
FIREBASE_WEB_VAPID_KEY=
