<?xml version="1.0" encoding="utf-8"?>
<!--
  FNASHHA — Android Permissions Snippet
  ======================================
  After running `npx cap add android`, merge these <uses-permission> entries
  into:  android/app/src/main/AndroidManifest.xml
  Place them inside the <manifest> element, before the <application> tag.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core network access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera — for photo uploads in service requests -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Microphone — for voice notes / support calls -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Storage — read/write photos on older Android versions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Media picker on Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Vibration — haptic feedback via @capacitor/haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Push notifications (FCM) — add when integrating Firebase -->
    <!-- <uses-permission android:name="android.permission.POST_NOTIFICATIONS" /> -->

</manifest>
