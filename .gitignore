# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
backups/

# Android SDK and Gradle cache (local build toolchain — not source)
.android-sdk/
.gradle-cache/
.fnashha-android-sdk/
.fnashha-gradle/

# Build artifacts and ephemeral scripts
.build-log
.build-run.sh
.build-status
nohup.out
result
zipFile.zip

# Binary/uploaded assets (not source code)
attached_assets/
screenshots/
artifacts/uploads/

# APK / AAB build outputs
*.apk
*.aab

# Expo native build outputs (the generated Android project source is committed,
# but local Gradle/CMake outputs and signing material are not)
artifacts/fnashha-expo/android/.gradle/
artifacts/fnashha-expo/android/build/
artifacts/fnashha-expo/android/app/build/
artifacts/fnashha-expo/android/app/.cxx/
artifacts/fnashha-expo/android/app/debug.keystore
artifacts/fnashha-expo/ios/

# Local environment variables (Replit Secrets are used instead on Replit)
.env
.env.*
!.env.example
